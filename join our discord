frame.Position = UDim2.new(0.5, -190, 0.5, -90) -- Centered on screen
frame.BackgroundColor3 = Color3.fromRGB(47, 49, 54) -- Discord Dark Theme Color
frame.BorderSizePixel = 0
frame.BackgroundTransparency = 1 -- Start invisible for fade-in effect
frame.Parent = screenGui

-- Rounded Corners for Main Frame
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 10)
uiCorner.Parent = frame

-- Create Header Label
local headerLabel = Instance.new("TextLabel")
