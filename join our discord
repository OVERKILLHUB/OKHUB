-- Rounded Corners for Button
local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 8)
buttonCorner.Parent = copyButton

-- Create Status Notification Label
local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, 0, 0, 25)
statusLabel.Position = UDim2.new(0, 0, 0, 140)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = ""
statusLabel.TextColor3 = Color3.fromRGB(67, 181, 129) -- Success Green
statusLabel.TextSize = 13
statusLabel.Font = Enum.Font.GothamSemibold
statusLabel.TextTransparency = 1
statusLabel.Parent = frame

-- Function to set transparency for all elements
local function tweenTransparency(targetTransparency, duration)
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	TweenService:Create(frame, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
	TweenService:Create(headerLabel, tweenInfo, {TextTransparency = targetTransparency}):Play()
	TweenService:Create(subLabel, tweenInfo, {TextTransparency = targetTransparency}):Play()
	TweenService:Create(copyButton, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
	TweenService:Create(copyButton, tweenInfo, {TextTransparency = targetTransparency}):Play()
end

-- Copy Button Click Logic
local isCopied = false
copyButton.MouseButton1Click:Connect(function()
	if isCopied then return end
	isCopied = true
	
	-- Copy to clipboard using Roblox's SetCore
	pcall(function()
		StarterGui:SetCore("CopyToClipboard", DISCORD_LINK)
	end)
	
	-- Update UI Feedback
	copyButton.Text = "Copied to Clipboard!"
	copyButton.BackgroundColor3 = Color3.fromRGB(67, 181, 129) -- Green
	statusLabel.Text = "Paste it into your browser to join!"
	
	-- Fade in status message
	TweenService:Create(statusLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
end)

-- Animation Sequence
task.spawn(function()
	-- Fade In
	tweenTransparency(0, 0.5)
	
	-- Display Duration
	task.wait(DISPLAY_TIME)
	
	-- Fade Out
	tweenTransparency(1, 0.5)
	TweenService:Create(statusLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
	
	-- Cleanup
	task.wait(0.5)
	screenGui:Destroy()
end)
